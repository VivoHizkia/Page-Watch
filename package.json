{
  "name": "page-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks a list of web pages on a schedule and reports what changed",
  "scripts": {
    "check": "tsx --env-file-if-exists=.env.local scripts/check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
