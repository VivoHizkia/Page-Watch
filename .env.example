# Every variable here is optional. With none of them set the monitor still runs: summaries are
# plain line counts and no message is sent.

# Key for any OpenAI-compatible Chat Completions endpoint, used to summarise changes.
# Default: Gemini through Google AI Studio (free tier). https://aistudio.google.com/apikey
LLM_API_KEY=

# Change these to use another provider (Groq, OpenAI, OpenRouter, a local Ollama).
LLM_BASE_URL=
LLM_MODEL=

# Telegram notifications. The token comes from @BotFather; the chat ID from a chat with your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
